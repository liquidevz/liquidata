# Liquidata Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=https://api.liquidata.dev

# TinyMCE Editor
NEXT_PUBLIC_TINYMCE_API_KEY=your_tinymce_api_key_here

# SEO Configuration
NEXT_PUBLIC_SITE_URL=https://liquidata.dev
NEXT_PUBLIC_SITE_NAME=Liquidata
NEXT_PUBLIC_SITE_TITLE=Liquidata - Custom Software & Hardware Solutions
NEXT_PUBLIC_SITE_DESCRIPTION=Transform your business with cutting-edge data analytics, AI-powered insights, and custom software solutions.

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-4W3WHHYRT3

# Social Media
NEXT_PUBLIC_TWITTER_HANDLE=@liquidata
NEXT_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id
NEXT_PUBLIC_LINKEDIN_COMPANY=liquidata

# Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=contact@liquidata.dev
NEXT_PUBLIC_CONTACT_PHONE=+1-XXX-XXX-XXXX

# Business Information (for Schema.org)
NEXT_PUBLIC_BUSINESS_NAME=Liquidata
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=Liquidata Inc.
NEXT_PUBLIC_BUSINESS_FOUNDED=2020
NEXT_PUBLIC_BUSINESS_ADDRESS_COUNTRY=US

# Feature Flags
NEXT_PUBLIC_ENABLE_CHATBOT=false
NEXT_PUBLIC_ENABLE_BLOG=true
NEXT_PUBLIC_ENABLE_CASE_STUDIES=true

# Environment
NODE_ENV=production
